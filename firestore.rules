rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function u() { return request.auth.token.email.split('@')[0]; }
    function yo() { return get(/databases/$(db)/documents/cuentas/$(u())).data; }
    function principal() { return request.auth != null && get(/databases/$(db)/documents/config/dueno).data.uid == request.auth.uid; }
    function activo() { return request.auth != null && yo().estado == 'ok' && yo().rango != ''; }
    function dueno() { return principal() || (activo() && yo().rango == 'Dueño'); }
    function tiene(l) { return activo() && yo().permisos.keys().hasAny(l); }
    function fin() { return dueno() || tiene(['hoy','pgc','bus','reg','ing','gas','cli','emp','ctl','chq','sem','cajctl']); }
    function bole() { return tiene(['bol']); }
    function pagos() { return tiene(['pgd']); }
    function caja() { return tiene(['caj']); }
    function depo() { return tiene(['tra','mer']); }
    function mio() { return 'a_' + u(); }
    function esMia() { return activo() && (resource.data.empleado == yo().nombre || resource.data.empleado == yo().empleado); }

    match /config/dueno {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /config/{id} {
      allow read: if activo() || dueno();
      allow write: if id != 'dueno' && (fin() || (id == 'diarco' && caja()));
    }
    match /cuentas/{id} {
      allow get: if request.auth != null && id == u();
      allow read: if activo() || dueno();
      allow create: if request.auth != null && id == u()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'ok'
        && request.resource.data.permisos.size() == 0
        && (request.resource.data.rango == '' || (request.resource.data.rango == 'Dueño' && principal()));
      allow update: if dueno();
    }
    match /{col}/{id} {
      allow read, write: if col != 'cuentas' && col != 'config' && fin();
      allow read: if col in ['cajas','retcaja','retiros','personas','cierresmes'] && caja();
      allow create: if col in ['cajas','retcaja','ingresos','tarjetas','retiros','diarco','historial'] && caja() && request.resource.data.por == mio();
      allow update: if col == 'retiros' && caja() && resource.data.por == mio() && resource.data.origen == 'caja';
      allow read: if col in ['traslados','mermas','envases','proveedores','personas','cierresmes'] && depo();
      allow create, update: if col in ['traslados','mermas','envases'] && depo();
      allow create: if col == 'historial' && activo() && request.resource.data.por == mio();
      allow read: if col == 'proveedores' && bole();
      allow read: if col == 'boletas' && bole() && resource.data.por == mio();
      allow create: if col == 'boletas' && bole() && request.resource.data.por == mio() && request.resource.data.estado == 'por revisar';
      allow create: if col == 'proveedores' && bole() && request.resource.data.por == mio();
      allow update: if col == 'proveedores' && bole() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rubro','cuit']);
      allow read: if col in ['pagosdir','pagosadj','pgefec'] && pagos();
      allow create: if col in ['pagosadj','pgefec'] && pagos() && request.resource.data.por == mio();
      allow create: if col == 'pagosdir' && pagos() && request.resource.data.por == mio() && request.resource.data.estado == 'ok' && !('revisado' in request.resource.data);
      allow read: if col in ['retiros','adelantos','liquidaciones','descuentos','novedades'] && esMia();
    }
  }
}
